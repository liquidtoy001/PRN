# LaTeX build intermediates (keep final .tex and .pdf files)
**/*.aux
**/*.fls
**/*.fdb_latexmk
**/*.log
**/*.out
**/*.synctex.gz

# Local evaluation and rendering scratch
pre-review-notes/tmp/
pre-review-notes/evals/**/build/
pre-review-notes/evals/**/build-zh/

# User-owned and third-party source material stays local
test-data/
downloads/
examples/stat3007/slides/*.pdf

# Generated release artifacts belong in GitHub Releases, not Git history
dist/

# Python/editor/OS noise
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.DS_Store
Thumbs.db
.vscode/
